# Example Nginx configuration for the Housing project

# ---------------------------------------------------------
# Admin Frontend (http://212.90.121.97:5183)
# ---------------------------------------------------------
server {
    listen 80;
    server_name 212.90.121.97;

    # If you want to use a subdomain pattern with Nginx proxying to Vite:
    location /admin/ {
        proxy_pass http://localhost:5183/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location /portal/ {
        proxy_pass http://localhost:5184/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location /api/ {
        proxy_pass http://localhost:3004/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}

